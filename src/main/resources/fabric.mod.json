{
  "schemaVersion": 1,
  "id": "vinylmusicplayer",
  "version": "${version}",
  "name": "Needledrop",
  "description": "A spinning vinyl disc with a full music player, your own songs plus Minecraft's, YouTube Music and Spotify sync, and a volume mixer for every sound in the game.",
  "authors": [
    "Vinyl Music Player"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.vinylmusic.client.VinylClient"
    ],
    "modmenu": [
      "com.vinylmusic.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    {
      "config": "vinyl-music-player.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}